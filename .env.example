# ARGUS configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env to git.

# --- Required for Veo clips & AI voiceover -------------------------------
# Get a key: https://aistudio.google.com/apikey
# (GEMINI_API_KEY and GOOGLE_API_KEY are also accepted)
ARGUS_GEMINI_API_KEY=

# --- Optional: ElevenLabs voices (Brian, Adam, George, Daniel) ------------
# Ключ: https://elevenlabs.io -> API Keys. ВАЖНО: настоящий ключ начинается
# со sk_ и показывается ТОЛЬКО в момент создания. ID ключа (длинная hex-
# строка) API отвергает с ошибкой "api_key_id_used_as_api_key".
# Free-тариф: клоны недоступны (Starter+), голоса серии работают.
ELEVENLABS_API_KEY=

# --- Veo provider ----------------------------------------------------------
# "api"  = official Gemini API (stable, paid - Veo has no free API tier)
# "flow" = your logged-in Google Flow browser session (free monthly credits;
#          run the flow_login tool once, profile is saved to disk)
ARGUS_VEO_PROVIDER=api
# Where the Flow browser profile lives (default ~/.argus/flow_profile)
ARGUS_FLOW_PROFILE=

# --- Models (sane defaults, override if you like) -------------------------
# Veo model used for clip generation. Fast model = cheaper.
ARGUS_VEO_MODEL=veo-3.1-fast-generate-preview
# Gemini native TTS model for the voiceover.
# gemini-2.5-flash-preview-tts и прочие preview-модели выключены 2026-11-17.
ARGUS_TTS_MODEL=gemini-3.8-flash-tts
# Default narrator voice (e.g. Charon, Puck, Kore, Fenrir).
ARGUS_DEFAULT_VOICE=Charon

# --- Master format --------------------------------------------------------
ARGUS_WIDTH=1080
ARGUS_HEIGHT=1920
ARGUS_FPS=30
# Target integrated loudness of the master track (LUFS).
ARGUS_LOUDNESS_TARGET=-14

# ElevenLabs TTS model id. eleven_v3 / eleven_v4 take audio tags ([whispers]);
# SSML <break> works only on the v2 family (eleven_multilingual_v2, flash).
ARGUS_ELEVEN_MODEL=eleven_v3
# Voice provider when synthesize_voiceover gets none: elevenlabs | edge | gemini.
# Empty = elevenlabs when its key is set, otherwise edge (free, no key).
ARGUS_TTS_PROVIDER=
# faster-whisper model size for watch_video transcripts (needs the asr extra).
# Sizes: tiny, base, small, medium, large-v3.
ARGUS_WHISPER_MODEL=small

# --- Rendering ------------------------------------------------------------
# Remotion render workers. 0 = let the renderer pick from the CPU count.
ARGUS_RENDER_CONCURRENCY=0

# --- Paths ----------------------------------------------------------------
# Where generated clips / audio / masters are written by default.
OMNIFRAME_OUTPUT_DIR=./output
# Where learn_and_record_memory saves your lasting preferences; studio_guide returns them.
ARGUS_KNOWLEDGE_BASE=./KNOWLEDGE_BASE.md
# User scripts that run_script can call (see scripts/README.md once it exists).
ARGUS_SCRIPTS_DIR=~/.argus/scripts
# Optional: an env file other than ./.env. Lookup order: this file (if it exists),
# then ./.env, then the .env in the ARGUS repository root.
ARGUS_ENV_FILE=

# --- Executables (autodetected from PATH when empty) ----------------------
ARGUS_FFMPEG=
ARGUS_FFPROBE=
